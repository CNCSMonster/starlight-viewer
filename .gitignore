# 依赖与打包产物
node_modules/
dist/
.astro/
*.log

# 关键：绝不跟踪外部笔记源软链接及其实际内容
src/content/docs
src/content/docs/

# 系统环境文件与敏感配置
.env
.env.*
.DS_Store
Thumbs.db

# 代码索引工具产物（codanna / fastembed 缓存）
.codanna/
.codannaignore
.fastembed_cache

# Orama 搜索索引持久化缓存（内存索引的磁盘快照，可再生）
.orama-index.json
.orama-index.json.tmp

# 本地预览产物（架构图/截图，由工具生成，不入库）
public/preview/

# 本地备份（脚本改动前的时间戳副本，不入库）
*.bak-*

# 本地截图辅助页（iframe 定位工具，含内部路径）
public/_shot.html
